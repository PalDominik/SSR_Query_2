<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
    <h1><%= title %></h1>
    <form method="get">
        <input type="text" name="neve">
        <button type="submit">Kereses</button>
    </form>

    <ul>
        <% expenses.forEach(elem => { %>
            <li>Név: <%= elem.name %>, Költség: <%= elem.amount %>, Kategoria: <%= elem.category %>  </li>   
        <% }); %>   
    </ul>

    <a href="/">Vissza az elágazásra</a>
</body>
</html>